# 编译输出目录
bin/
obj/

# 用户自定义配置文件
*.user
*.suo
*.userosscache
*.sln.docstates

# 构建工具相关
*.builds
*.log

# 临时文件
*.tmp
*.temp
.cache/

# VS 相关
.vs/
.vscode/
*.vscode/

# 程序集缓存
*.pdb
*.mdf
*.ldf
*.sdf

# 发布目录
publish/

# 编译产物
# AutoCAD 依赖 DLL（acdbmgd.dll / acmgd.dll / accoremgd.dll）不随仓库分发，
# 需从本机 AutoCAD 安装目录手动复制到 build/References/，见该目录下的 README.md
*.exe
*.dll
