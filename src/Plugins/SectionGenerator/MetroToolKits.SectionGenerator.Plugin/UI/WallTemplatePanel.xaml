<UserControl x:Class="MetroToolKits.SectionGenerator.Plugin.UI.WallTemplatePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Column="0" Header="模板列表" Padding="6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="新增模板" Width="90" Margin="0,0,8,0" Click="AddTemplate_Click"/>
                    <Button Content="删除模板" Width="90" Click="RemoveTemplate_Click"/>
                </StackPanel>
                <ListBox x:Name="TemplateListBox"
                         DisplayMemberPath="TemplateName"
                         SelectionChanged="TemplateListBox_SelectionChanged"/>
            </DockPanel>
        </GroupBox>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <GroupBox Header="基础信息" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="模板名称"/>
                    <TextBox x:Name="TemplateNameBox" Grid.Row="0" Grid.Column="1" Margin="0,0,8,6"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Text="模板标识"/>
                    <TextBox x:Name="TemplateIdBox" Grid.Row="0" Grid.Column="3" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="核心名称"/>
                    <TextBox x:Name="CoreNameBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,6"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="识别方式"/>
                    <ComboBox x:Name="RecognitionModeBox" Grid.Row="1" Grid.Column="3" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="核心厚度(mm)"/>
                    <TextBox x:Name="CoreThicknessBox" Grid.Row="2" Grid.Column="1" Margin="0,0,8,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Text="核心类别"/>
                    <TextBox x:Name="CoreCategoryBox" Grid.Row="2" Grid.Column="3"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="竖向锚定"/>
                    <ComboBox x:Name="VerticalAnchorModeBox" Grid.Row="3" Grid.Column="1" Margin="0,6,8,0"/>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="左侧附加层" Padding="8" Margin="0,10,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="新增左层" Width="90" Margin="0,0,8,0" Click="AddLeftLayer_Click"/>
                        <Button Content="删除左层" Width="90" Click="RemoveLeftLayer_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="LeftLayerGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="顺序" Binding="{Binding Order}" Width="70"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="厚度" Binding="{Binding Thickness}" Width="90"/>
                            <DataGridTextColumn Header="类别" Binding="{Binding MaterialOrCategory}" Width="130"/>
                            <DataGridCheckBoxColumn Header="剖面可见" Binding="{Binding VisibleInSection}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="右侧附加层" Padding="8" Margin="0,10,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="新增右层" Width="90" Margin="0,0,8,0" Click="AddRightLayer_Click"/>
                        <Button Content="删除右层" Width="90" Click="RemoveRightLayer_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="RightLayerGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="顺序" Binding="{Binding Order}" Width="70"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="厚度" Binding="{Binding Thickness}" Width="90"/>
                            <DataGridTextColumn Header="类别" Binding="{Binding MaterialOrCategory}" Width="130"/>
                            <DataGridCheckBoxColumn Header="剖面可见" Binding="{Binding VisibleInSection}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存模板" Width="100" Margin="0,0,8,0" Click="SaveButton_Click" IsDefault="True"/>
            <Button Content="取消" Width="84" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</UserControl>
