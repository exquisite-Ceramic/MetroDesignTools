<UserControl x:Class="MetroToolKits.SectionGenerator.Plugin.UI.WorkbenchMaintenancePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hosting="clr-namespace:MetroToolKits.Foundation.Core.Hosting;assembly=MetroToolKits.Foundation.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <GroupBox Header="剖面状态摘要">
                <StackPanel Margin="8">
                    <TextBlock x:Name="MaintenanceSummaryTextBlock" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock x:Name="MaintenanceCountsTextBlock" TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="维护入口" Margin="0,10,0,0">
                <StackPanel Margin="6">
                    <Button Content="查看或更新剖面"
                            Tag="{x:Static hosting:SectionGeneratorCommandNames.CheckSectionUpdates}"
                            Height="30"
                            Click="CommandButton_Click"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
