<UserControl x:Class="MetroToolKits.SectionGenerator.Plugin.UI.WorkbenchPreparationSummaryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hosting="clr-namespace:MetroToolKits.Foundation.Core.Hosting;assembly=MetroToolKits.Foundation.Core">
    <StackPanel>
        <GroupBox Header="构件识别摘要">
            <StackPanel Margin="8">
                <TextBlock x:Name="PreparationSummaryTextBlock" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock x:Name="PreparationCountsTextBlock" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock x:Name="PreparationModeTextBlock" TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="图层映射入口" Margin="0,10,0,8">
            <StackPanel Margin="6">
                <Button Content="打开独立图层映射窗口"
                        Tag="{x:Static hosting:SectionGeneratorCommandNames.LayerMapping}"
                        Height="30"
                        Margin="0,0,0,6"
                        Click="CommandButton_Click"/>
                <Button Content="墙体模板管理"
                        Tag="OpenWallTemplateManager"
                        Height="30"
                        Margin="0,0,0,6"
                        Click="CommandButton_Click"/>
                <Button Content="楼板模板管理"
                        Tag="OpenSlabTemplateManager"
                        Height="30"
                        Margin="0,0,0,6"
                        Click="CommandButton_Click"/>
                <TextBlock x:Name="PreparationEntryHintTextBlock"
                           Text="图层映射会打开原图层映射窗口，墙体模板和楼板模板管理仍使用原独立模板管理窗口。"
                           Foreground="Gray"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
