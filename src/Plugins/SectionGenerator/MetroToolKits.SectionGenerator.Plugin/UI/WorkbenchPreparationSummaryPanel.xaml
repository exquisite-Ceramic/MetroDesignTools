<UserControl x:Class="MetroToolKits.SectionGenerator.Plugin.UI.WorkbenchPreparationSummaryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hosting="clr-namespace:MetroToolKits.Foundation.Core.Hosting;assembly=MetroToolKits.Foundation.Core">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="构件识别摘要">
            <StackPanel Margin="8">
                <TextBlock x:Name="PreparationSummaryTextBlock"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <TextBlock x:Name="PreparationCountsTextBlock"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
                <TextBlock x:Name="PreparationModeTextBlock"
                           TextWrapping="Wrap"
                           Foreground="#465A6E"/>
            </StackPanel>
        </GroupBox>

        <Border Grid.Row="1"
                Margin="0,8,0,0"
                Padding="10"
                CornerRadius="4"
                BorderBrush="#D7E0EC"
                BorderThickness="1"
                Background="#FBFCFE">
            <StackPanel>
                <TextBlock Text="辅助入口"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <TextBlock x:Name="PreparationEntryHintTextBlock"
                           Text="图层映射会打开原图层映射窗口，墙体模板和楼板模板管理仍使用原独立模板管理窗口。"
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
                <WrapPanel>
                    <Button Content="打开独立图层映射窗口"
                            Tag="{x:Static hosting:SectionGeneratorCommandNames.LayerMapping}"
                            Height="28"
                            Margin="0,0,8,8"
                            Padding="12,0"
                            Click="CommandButton_Click"/>
                    <Button Content="墙体模板管理"
                            Tag="OpenWallTemplateManager"
                            Height="28"
                            Margin="0,0,8,8"
                            Padding="12,0"
                            Click="CommandButton_Click"/>
                    <Button Content="楼板模板管理"
                            Tag="OpenSlabTemplateManager"
                            Height="28"
                            Margin="0,0,0,8"
                            Padding="12,0"
                            Click="CommandButton_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
