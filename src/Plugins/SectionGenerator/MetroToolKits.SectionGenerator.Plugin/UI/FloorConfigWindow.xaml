<Window x:Class="MetroToolKits.SectionGenerator.Plugin.UI.FloorConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="楼层配置管理" Height="560" Width="680"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 主内容区 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：楼层列表 -->
            <GroupBox Grid.Column="0" Header="楼层列表" Margin="0,0,5,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox Grid.Row="0" x:Name="FloorListBox"
                             SelectionChanged="FloorListBox_SelectionChanged"
                             DisplayMemberPath="Name"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                        <Button Content="添加" Width="55" Height="26" Margin="0,0,5,0"
                                Click="AddFloor_Click"/>
                        <Button Content="删除" Width="55" Height="26" Margin="0,0,5,0"
                                Click="DeleteFloor_Click"/>
                        <Button Content="↑" Width="28" Height="26" Margin="0,0,3,0"
                                Click="MoveUp_Click"/>
                        <Button Content="↓" Width="28" Height="26"
                                Click="MoveDown_Click"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- 右侧：楼层参数编辑 -->
            <GroupBox Grid.Column="1" Header="楼层参数" Margin="5,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="EditPanel" IsEnabled="False" Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="楼层名称:"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Margin="0,2"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="层高 (mm):"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="HeightBox" Margin="0,2"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="底板厚度 (mm):"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="BottomSlabBox" Margin="0,2"/>

                        <Label Grid.Row="3" Grid.Column="0" Content="顶板厚度 (mm):"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TopSlabBox" Margin="0,2"/>

                        <Label Grid.Row="4" Grid.Column="0" Content="装修面层 (mm):"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="FinishBox" Margin="0,2"/>

                        <Label Grid.Row="5" Grid.Column="0" Content="启用坡度:"/>
                        <CheckBox Grid.Row="5" Grid.Column="1" x:Name="SlopeCheck"
                                  VerticalAlignment="Center" Margin="0,2"
                                  Checked="SlopeCheck_Changed" Unchecked="SlopeCheck_Changed"/>

                        <Label Grid.Row="6" Grid.Column="0" Content="坡度值 (%):"/>
                        <TextBox Grid.Row="6" Grid.Column="1" x:Name="SlopeValueBox" Margin="0,2"/>

                        <Separator Grid.Row="7" Grid.ColumnSpan="2" Margin="0,8"/>

                        <Label Grid.Row="8" Grid.Column="0" Content="对齐点:" VerticalAlignment="Top"/>
                        <StackPanel Grid.Row="8" Grid.Column="1" Margin="0,2">
                            <TextBlock x:Name="AlignmentStatus" Text="未设置" Foreground="Gray" Margin="0,0,0,4"/>
                            <Button Content="拾取对齐点..." Height="26" Click="PickAlignment_Click"/>
                            <Button Content="清除对齐点" Height="26" Margin="0,4,0,0" Click="ClearAlignment_Click"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <!-- 全局坡度设置 -->
        <GroupBox Grid.Row="1" Header="全局设置" Margin="0,8,0,0">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" x:Name="GlobalSlopeCheck" Content="全局坡度"
                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Label Grid.Column="1" Content="坡度值 (%):" VerticalAlignment="Center"/>
                <TextBox Grid.Column="2" x:Name="GlobalSlopeValueBox" Width="60" Margin="4,0"/>
                <Label Grid.Column="3" Content="作用对象:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <ComboBox Grid.Column="4" x:Name="GlobalSlopeTargetBox" Margin="4,0" Width="120"
                          HorizontalAlignment="Left">
                    <ComboBoxItem Content="结构楼板" Tag="StructuralSlab" IsSelected="True"/>
                    <ComboBoxItem Content="装修面层" Tag="FinishLayer"/>
                </ComboBox>
            </Grid>
        </GroupBox>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="保存" Width="80" Height="30" Margin="5,0" Click="Save_Click"/>
            <Button Content="取消" Width="80" Height="30" Margin="5,0" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
