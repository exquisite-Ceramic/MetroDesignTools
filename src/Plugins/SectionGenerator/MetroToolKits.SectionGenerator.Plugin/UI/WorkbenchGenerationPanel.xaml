<UserControl x:Class="MetroToolKits.SectionGenerator.Plugin.UI.WorkbenchGenerationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hosting="clr-namespace:MetroToolKits.Foundation.Core.Hosting;assembly=MetroToolKits.Foundation.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <GroupBox Header="生成条件">
                <StackPanel Margin="8">
                    <TextBlock x:Name="GenerationStatusTextBlock" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock x:Name="GenerationSummaryTextBlock" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock x:Name="MissingItemsSummaryTextBlock" TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="生成入口" Margin="0,10,0,0">
                <StackPanel Margin="6">
                    <Button Content="开始生成剖面"
                            Tag="{x:Static hosting:SectionGeneratorCommandNames.GenSection}"
                            Height="30"
                            Click="CommandButton_Click"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
