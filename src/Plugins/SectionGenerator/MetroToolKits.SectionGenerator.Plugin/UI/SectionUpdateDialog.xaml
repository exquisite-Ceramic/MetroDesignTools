<Window x:Class="MetroToolKits.SectionGenerator.Plugin.UI.SectionUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="剖面更新检查" Height="420" Width="620"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 状态摘要 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock x:Name="SummaryText" FontSize="13" VerticalAlignment="Center"/>
            <Button Content="刷新" Width="60" Height="26" Margin="15,0,0,0"
                    Click="Refresh_Click"/>
        </StackPanel>

        <!-- 剖面列表 -->
        <DataGrid Grid.Row="1" x:Name="ResultGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  CanUserAddRows="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Width="30" Binding="{Binding IsSelected}"/>
                <DataGridTextColumn Header="剖面名称" Width="*" Binding="{Binding BlockName}"/>
                <DataGridTextColumn Header="状态" Width="120" Binding="{Binding StatusText}"/>
                <DataGridTextColumn Header="受影响楼层" Width="150" Binding="{Binding OutdatedFloorsText}"/>
                <DataGridTextColumn Header="跳过楼层" Width="150" Binding="{Binding SkippedFloorsText}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 全选/反选 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="全选" Width="60" Height="26" Margin="0,0,8,0" Click="SelectAll_Click"/>
            <Button Content="全不选" Width="60" Height="26" Click="SelectNone_Click"/>
        </StackPanel>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="更新选中" Width="90" Height="30" Margin="5,0"
                    Click="UpdateSelected_Click"/>
            <Button Content="全部更新" Width="90" Height="30" Margin="5,0"
                    Click="UpdateAll_Click"/>
            <Button Content="关闭" Width="80" Height="30" Margin="5,0"
                    Click="Close_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
