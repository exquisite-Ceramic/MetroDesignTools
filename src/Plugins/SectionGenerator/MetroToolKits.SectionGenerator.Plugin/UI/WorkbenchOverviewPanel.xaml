<UserControl x:Class="MetroToolKits.SectionGenerator.Plugin.UI.WorkbenchOverviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hosting="clr-namespace:MetroToolKits.Foundation.Core.Hosting;assembly=MetroToolKits.Foundation.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <TextBlock Text="MetroToolKits 工作台" FontSize="18" FontWeight="Bold"/>
            <TextBlock x:Name="StatusTextBlock" Margin="0,4,0,10" Foreground="Gray" TextWrapping="Wrap"/>

            <Border Background="#EEF5FF" BorderBrush="#C8D7F0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="建议操作" FontWeight="SemiBold"/>
                    <TextBlock x:Name="RecommendedActionTextBlock" Margin="0,6,0,8" TextWrapping="Wrap"/>
                    <DockPanel>
                        <Button Content="刷新状态" Width="84" Height="28" DockPanel.Dock="Right" Click="RefreshButton_Click"/>
                        <Button x:Name="PrimaryActionButton"
                                Content="开始生成剖面"
                                Tag="{x:Static hosting:SectionGeneratorCommandNames.GenSection}"
                                Height="32"
                                Click="CommandButton_Click"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <GroupBox Header="当前图纸状态">
                <StackPanel Margin="8">
                    <TextBlock x:Name="ConfigSummaryTextBlock" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock x:Name="ReadinessSummaryTextBlock" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock x:Name="SectionsSummaryTextBlock" TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="快捷操作" Margin="0,10,0,0">
                <StackPanel Margin="6">
                    <Button Content="开始生成剖面"
                            Tag="{x:Static hosting:SectionGeneratorCommandNames.GenSection}"
                            Height="30"
                            Margin="0,0,0,6"
                            Click="CommandButton_Click"/>
                    <Button Content="楼层配置"
                            Tag="{x:Static hosting:SectionGeneratorCommandNames.FloorConfig}"
                            Height="30"
                            Margin="0,0,0,6"
                            Click="CommandButton_Click"/>
                    <Button Content="图层映射"
                            Tag="{x:Static hosting:SectionGeneratorCommandNames.LayerMapping}"
                            Height="30"
                            Margin="0,0,0,6"
                            Click="CommandButton_Click"/>
                    <Button Content="查看或更新剖面"
                            Tag="{x:Static hosting:SectionGeneratorCommandNames.CheckSectionUpdates}"
                            Height="30"
                            Click="CommandButton_Click"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
