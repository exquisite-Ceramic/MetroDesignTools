<UserControl x:Class="MetroToolKits.SectionGenerator.Plugin.UI.SectionToolboxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hosting="clr-namespace:MetroToolKits.Foundation.Core.Hosting;assembly=MetroToolKits.Foundation.Core"
             xmlns:local="clr-namespace:MetroToolKits.SectionGenerator.Plugin.UI"
             Width="360">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#F4F7FB"
                BorderBrush="#D7E0EC"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8"
                Margin="10,10,10,0">
            <DockPanel LastChildFill="True">
                <Button Content="关闭工具箱"
                        Width="92"
                        Height="28"
                        DockPanel.Dock="Right"
                        Click="HideToolboxButton_Click"/>
                <TextBlock VerticalAlignment="Center"
                           Foreground="Gray"
                           Text="关闭只会隐藏当前工具箱，不会保存、取消或清空当前工作台状态。"
                           TextWrapping="Wrap"
                           Margin="0,0,12,0"/>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" x:Name="WorkbenchTabs" Margin="10">
            <TabItem Header="总览">
                <local:WorkbenchOverviewPanel x:Name="WorkbenchOverviewPanelHost"/>
            </TabItem>

            <TabItem x:Name="FloorConfigTabItem" Header="楼层配置">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#F4F7FB"
                            BorderBrush="#D7E0EC"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8"
                            Margin="0,0,0,8">
                        <DockPanel LastChildFill="True">
                            <Button Content="刷新楼层配置"
                                    Width="108"
                                    Height="28"
                                    DockPanel.Dock="Right"
                                    Click="RefreshFloorConfigButton_Click"/>
                            <TextBlock x:Name="FloorConfigBindingText"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>

                    <local:FloorConfigPanel Grid.Row="1" x:Name="FloorConfigPanelHost"/>
                </Grid>
            </TabItem>

            <TabItem Header="图纸准备">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#F4F7FB"
                            BorderBrush="#D7E0EC"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,6"
                            Margin="0,0,0,6">
                        <DockPanel LastChildFill="True">
                            <Button Content="刷新图层映射"
                                    Width="108"
                                    Height="28"
                                    DockPanel.Dock="Right"
                                    Click="RefreshLayerMappingButton_Click"/>
                            <TextBlock x:Name="LayerMappingBindingText"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>

                    <local:WorkbenchPreparationSummaryPanel Grid.Row="1"
                                                            Margin="0,0,0,6"
                                                            x:Name="WorkbenchPreparationSummaryPanelHost"/>

                    <GroupBox Grid.Row="2" Header="图层映射编辑">
                        <Grid Margin="6,4,6,6">
                            <local:LayerMappingPanel x:Name="LayerMappingPanelHost"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="剖面生成">
                <local:WorkbenchGenerationPanel x:Name="WorkbenchGenerationPanelHost"/>
            </TabItem>

            <TabItem Header="剖面维护">
                <local:WorkbenchMaintenancePanel x:Name="WorkbenchMaintenancePanelHost"/>
            </TabItem>

            <TabItem Header="模板与输出">
                <Grid Margin="10">
                     <Grid x:Name="TemplatesHomeView">
                         <ScrollViewer VerticalScrollBarVisibility="Auto">
                             <StackPanel>
                                <TextBlock x:Name="TemplatesSummaryText"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>

                                <local:WorkbenchTemplatesOutputPanel x:Name="WorkbenchTemplatesOutputPanelHost"/>
                            </StackPanel>
                         </ScrollViewer>
                     </Grid>

                    <Grid x:Name="WallTemplatePanelView" Visibility="Collapsed">
                        <local:WallTemplatePanel x:Name="WallTemplatePanelHost"/>
                    </Grid>

                    <Grid x:Name="SlabTemplatePanelView" Visibility="Collapsed">
                        <local:SlabTemplatePanel x:Name="SlabTemplatePanelHost"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
