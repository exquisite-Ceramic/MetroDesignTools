<UserControl x:Class="MetroToolKits.SectionGenerator.Plugin.UI.SectionToolboxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="300">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <TextBlock Text="MetroToolKits 工具箱" FontSize="18" FontWeight="Bold"/>
            <TextBlock x:Name="StatusText" Margin="0,4,0,10" Foreground="Gray"/>

            <GroupBox Header="剖面">
                <StackPanel Margin="6">
                    <Button Content="生成剖面" Tag="GenSection" Height="30" Margin="0,0,0,6" Click="CommandButton_Click"/>
                    <Button Content="检测更新" Tag="CheckSectionUpdates" Height="30" Margin="0,0,0,6" Click="CommandButton_Click"/>
                    <Button Content="更新剖面" Tag="UpdateSection" Height="30" Click="CommandButton_Click"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="双向定位" Margin="0,8,0,0">
                <StackPanel Margin="6">
                    <Button Content="剖面定位源构件" Tag="LocateSourceElement" Height="30" Margin="0,0,0,6" Click="CommandButton_Click"/>
                    <Button Content="查询关联剖面" Tag="FindRelatedSections" Height="30" Click="CommandButton_Click"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="转换与配置" Margin="0,8,0,0">
                <StackPanel Margin="6">
                    <Button Content="楼层配置" Tag="FloorConfig" Height="30" Margin="0,0,0,6" Click="CommandButton_Click"/>
                    <Button Content="图层映射" Tag="LayerMapping" Height="30" Margin="0,0,0,6" Click="CommandButton_Click"/>
                    <Button Content="区域转换" Tag="ConvertRegion" Height="30" Margin="0,0,0,6" Click="CommandButton_Click"/>
                    <Button Content="恢复转换" Tag="RevertConversion" Height="30" Click="CommandButton_Click"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
