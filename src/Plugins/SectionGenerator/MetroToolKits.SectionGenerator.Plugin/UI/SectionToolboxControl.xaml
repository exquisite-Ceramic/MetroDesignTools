<UserControl x:Class="MetroToolKits.SectionGenerator.Plugin.UI.SectionToolboxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hosting="clr-namespace:MetroToolKits.Foundation.Core.Hosting;assembly=MetroToolKits.Foundation.Core"
             xmlns:local="clr-namespace:MetroToolKits.SectionGenerator.Plugin.UI"
             Width="360">
    <Grid>
        <TabControl x:Name="WorkbenchTabs">
            <TabItem Header="总览">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="MetroToolKits 工作台" FontSize="18" FontWeight="Bold"/>
                        <TextBlock x:Name="StatusText" Margin="0,4,0,10" Foreground="Gray" TextWrapping="Wrap"/>

                        <Border Background="#EEF5FF" BorderBrush="#C8D7F0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="建议操作" FontWeight="SemiBold"/>
                                <TextBlock x:Name="RecommendedActionText" Margin="0,6,0,8" TextWrapping="Wrap"/>
                                <DockPanel>
                                    <Button Content="刷新状态" Width="84" Height="28" DockPanel.Dock="Right" Click="RefreshButton_Click"/>
                                    <Button x:Name="PrimaryActionButton"
                                            Content="开始生成剖面"
                                            Tag="{x:Static hosting:SectionGeneratorCommandNames.GenSection}"
                                            Height="32"
                                            Click="CommandButton_Click"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <GroupBox Header="当前图纸状态">
                            <StackPanel Margin="8">
                                <TextBlock x:Name="ConfigSummaryText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock x:Name="ReadinessSummaryText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock x:Name="SectionsSummaryText" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="快捷操作" Margin="0,10,0,0">
                            <StackPanel Margin="6">
                                <Button Content="开始生成剖面"
                                        Tag="{x:Static hosting:SectionGeneratorCommandNames.GenSection}"
                                        Height="30"
                                        Margin="0,0,0,6"
                                        Click="CommandButton_Click"/>
                                <Button Content="楼层配置"
                                        Tag="{x:Static hosting:SectionGeneratorCommandNames.FloorConfig}"
                                        Height="30"
                                        Margin="0,0,0,6"
                                        Click="CommandButton_Click"/>
                                <Button Content="图层映射"
                                        Tag="{x:Static hosting:SectionGeneratorCommandNames.LayerMapping}"
                                        Height="30"
                                        Margin="0,0,0,6"
                                        Click="CommandButton_Click"/>
                                <Button Content="查看或更新剖面"
                                        Tag="{x:Static hosting:SectionGeneratorCommandNames.CheckSectionUpdates}"
                                        Height="30"
                                        Click="CommandButton_Click"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="FloorConfigTabItem" Header="楼层配置">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#F4F7FB"
                            BorderBrush="#D7E0EC"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8"
                            Margin="0,0,0,8">
                        <DockPanel LastChildFill="True">
                            <Button Content="刷新楼层配置"
                                    Width="108"
                                    Height="28"
                                    DockPanel.Dock="Right"
                                    Click="RefreshFloorConfigButton_Click"/>
                            <TextBlock x:Name="FloorConfigBindingText"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>

                    <local:FloorConfigPanel Grid.Row="1" x:Name="FloorConfigPanelHost"/>
                </Grid>
            </TabItem>

            <TabItem Header="图纸准备">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#F4F7FB"
                            BorderBrush="#D7E0EC"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8"
                            Margin="0,0,0,8">
                        <DockPanel LastChildFill="True">
                            <Button Content="刷新图层映射"
                                    Width="108"
                                    Height="28"
                                    DockPanel.Dock="Right"
                                    Click="RefreshLayerMappingButton_Click"/>
                            <TextBlock x:Name="LayerMappingBindingText"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>

                    <GroupBox Grid.Row="1" Header="构件识别摘要">
                        <StackPanel Margin="8">
                            <TextBlock x:Name="PreparationSummaryText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock x:Name="PreparationCountsText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock x:Name="PreparationModeText" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="2" Header="图层映射入口" Margin="0,10,0,8">
                        <StackPanel Margin="6">
                            <Button Content="打开独立图层映射窗口"
                                    Tag="{x:Static hosting:SectionGeneratorCommandNames.LayerMapping}"
                                    Height="30"
                                    Margin="0,0,0,6"
                                    Click="CommandButton_Click"/>
                            <TextBlock Text="墙体模板和楼板模板管理入口保留在下方图层映射面板中。"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <local:LayerMappingPanel Grid.Row="3" x:Name="LayerMappingPanelHost"/>
                </Grid>
            </TabItem>

            <TabItem Header="剖面生成">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="生成条件">
                            <StackPanel Margin="8">
                                <TextBlock x:Name="GenerationStatusText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock x:Name="GenerationSummaryText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock x:Name="MissingItemsSummaryText" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="生成入口" Margin="0,10,0,0">
                            <StackPanel Margin="6">
                                <Button Content="开始生成剖面"
                                        Tag="{x:Static hosting:SectionGeneratorCommandNames.GenSection}"
                                        Height="30"
                                        Click="CommandButton_Click"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="剖面维护">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="剖面状态摘要">
                            <StackPanel Margin="8">
                                <TextBlock x:Name="MaintenanceSummaryText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock x:Name="MaintenanceCountsText" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="维护入口" Margin="0,10,0,0">
                            <StackPanel Margin="6">
                                <Button Content="查看或更新剖面"
                                        Tag="{x:Static hosting:SectionGeneratorCommandNames.CheckSectionUpdates}"
                                        Height="30"
                                        Click="CommandButton_Click"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="模板与输出">
                <Grid Margin="10">
                    <Grid x:Name="TemplatesHomeView">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <GroupBox Header="模板入口">
                                    <StackPanel Margin="8">
                                        <TextBlock x:Name="TemplatesSummaryText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <Button Content="进入墙体模板管理"
                                                Height="30"
                                                Margin="0,0,0,6"
                                                Click="EnterWallTemplatePanelButton_Click"/>
                                        <Button Content="进入楼板模板管理"
                                                Height="30"
                                                Click="EnterSlabTemplatePanelButton_Click"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="输出设置" Margin="0,10,0,0">
                                    <StackPanel Margin="8">
                                        <TextBlock x:Name="OutputSettingsHintText"
                                                   Text="输出设置仍在“楼层配置”Tab 的“输出设置”区域维护。"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,8"/>
                                        <Button Content="前往楼层配置"
                                                Height="30"
                                                Click="GoToFloorConfigTabButton_Click"/>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="WallTemplatePanelView" Visibility="Collapsed">
                        <local:WallTemplatePanel x:Name="WallTemplatePanelHost"/>
                    </Grid>

                    <Grid x:Name="SlabTemplatePanelView" Visibility="Collapsed">
                        <local:SlabTemplatePanel x:Name="SlabTemplatePanelHost"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
