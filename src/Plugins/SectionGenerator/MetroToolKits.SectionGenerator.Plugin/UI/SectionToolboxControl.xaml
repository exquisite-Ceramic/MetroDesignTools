<UserControl x:Class="MetroToolKits.SectionGenerator.Plugin.UI.SectionToolboxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hosting="clr-namespace:MetroToolKits.Foundation.Core.Hosting;assembly=MetroToolKits.Foundation.Core"
             xmlns:local="clr-namespace:MetroToolKits.SectionGenerator.Plugin.UI"
             Width="360">
    <Grid>
        <TabControl x:Name="WorkbenchTabs">
            <TabItem Header="总览">
                <local:WorkbenchOverviewPanel x:Name="WorkbenchOverviewPanelHost"/>
            </TabItem>

            <TabItem x:Name="FloorConfigTabItem" Header="楼层配置">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#F4F7FB"
                            BorderBrush="#D7E0EC"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8"
                            Margin="0,0,0,8">
                        <DockPanel LastChildFill="True">
                            <Button Content="刷新楼层配置"
                                    Width="108"
                                    Height="28"
                                    DockPanel.Dock="Right"
                                    Click="RefreshFloorConfigButton_Click"/>
                            <TextBlock x:Name="FloorConfigBindingText"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>

                    <local:FloorConfigPanel Grid.Row="1" x:Name="FloorConfigPanelHost"/>
                </Grid>
            </TabItem>

            <TabItem Header="图纸准备">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#F4F7FB"
                            BorderBrush="#D7E0EC"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8"
                            Margin="0,0,0,8">
                        <DockPanel LastChildFill="True">
                            <Button Content="刷新图层映射"
                                    Width="108"
                                    Height="28"
                                    DockPanel.Dock="Right"
                                    Click="RefreshLayerMappingButton_Click"/>
                            <TextBlock x:Name="LayerMappingBindingText"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>

                    <GroupBox Grid.Row="1" Header="构件识别摘要">
                        <StackPanel Margin="8">
                            <TextBlock x:Name="PreparationSummaryText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock x:Name="PreparationCountsText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock x:Name="PreparationModeText" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="2" Header="图层映射入口" Margin="0,10,0,8">
                        <StackPanel Margin="6">
                            <Button Content="打开独立图层映射窗口"
                                    Tag="{x:Static hosting:SectionGeneratorCommandNames.LayerMapping}"
                                    Height="30"
                                    Margin="0,0,0,6"
                                    Click="CommandButton_Click"/>
                            <TextBlock Text="墙体模板和楼板模板管理入口保留在下方图层映射面板中。"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <local:LayerMappingPanel Grid.Row="3" x:Name="LayerMappingPanelHost"/>
                </Grid>
            </TabItem>

            <TabItem Header="剖面生成">
                <local:WorkbenchGenerationPanel x:Name="WorkbenchGenerationPanelHost"/>
            </TabItem>

            <TabItem Header="剖面维护">
                <local:WorkbenchMaintenancePanel x:Name="WorkbenchMaintenancePanelHost"/>
            </TabItem>

            <TabItem Header="模板与输出">
                <Grid Margin="10">
                    <Grid x:Name="TemplatesHomeView">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <GroupBox Header="模板入口">
                                    <StackPanel Margin="8">
                                        <TextBlock x:Name="TemplatesSummaryText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <Button Content="进入墙体模板管理"
                                                Height="30"
                                                Margin="0,0,0,6"
                                                Click="EnterWallTemplatePanelButton_Click"/>
                                        <Button Content="进入楼板模板管理"
                                                Height="30"
                                                Click="EnterSlabTemplatePanelButton_Click"/>
                                    </StackPanel>
                                </GroupBox>

                                <local:OutputSettingsEntryPanel x:Name="OutputSettingsEntryPanelHost"
                                                                Margin="0,10,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="WallTemplatePanelView" Visibility="Collapsed">
                        <local:WallTemplatePanel x:Name="WallTemplatePanelHost"/>
                    </Grid>

                    <Grid x:Name="SlabTemplatePanelView" Visibility="Collapsed">
                        <local:SlabTemplatePanel x:Name="SlabTemplatePanelHost"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
