<UserControl x:Class="MetroToolKits.SectionGenerator.Plugin.UI.SectionToolboxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MetroToolKits.SectionGenerator.Plugin.UI"
             Width="360">
    <Grid>
        <TabControl x:Name="WorkbenchTabs">
            <TabItem Header="总览">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="MetroToolKits 工作台" FontSize="18" FontWeight="Bold"/>
                        <TextBlock x:Name="StatusText" Margin="0,4,0,10" Foreground="Gray" TextWrapping="Wrap"/>

                        <Border Background="#EEF5FF" BorderBrush="#C8D7F0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="建议操作" FontWeight="SemiBold"/>
                                <TextBlock x:Name="RecommendedActionText" Margin="0,6,0,8" TextWrapping="Wrap"/>
                                <DockPanel>
                                    <Button Content="刷新状态" Width="84" Height="28" DockPanel.Dock="Right" Click="RefreshButton_Click"/>
                                    <Button x:Name="PrimaryActionButton" Content="开始生成剖面" Tag="GenSection" Height="32" Click="CommandButton_Click"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <GroupBox Header="当前图纸状态">
                            <StackPanel Margin="8">
                                <TextBlock x:Name="ConfigSummaryText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock x:Name="ReadinessSummaryText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock x:Name="SectionsSummaryText" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="快捷操作" Margin="0,10,0,0">
                            <StackPanel Margin="6">
                                <Button Content="开始生成剖面" Tag="GenSection" Height="30" Margin="0,0,0,6" Click="CommandButton_Click"/>
                                <Button Content="楼层配置" Tag="FloorConfig" Height="30" Margin="0,0,0,6" Click="CommandButton_Click"/>
                                <Button Content="图层映射" Tag="LayerMapping" Height="30" Margin="0,0,0,6" Click="CommandButton_Click"/>
                                <Button Content="检测更新" Tag="CheckSectionUpdates" Height="30" Click="CommandButton_Click"/>
                            </StackPanel>
                        </GroupBox>

                        <Expander Header="更多命令" Margin="0,10,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <GroupBox Header="剖面">
                                    <StackPanel Margin="6">
                                        <Button Content="生成剖面" Tag="GenSection" Height="30" Margin="0,0,0,6" Click="CommandButton_Click"/>
                                        <Button Content="检测更新" Tag="CheckSectionUpdates" Height="30" Margin="0,0,0,6" Click="CommandButton_Click"/>
                                        <Button Content="更新剖面" Tag="UpdateSection" Height="30" Click="CommandButton_Click"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="双向定位" Margin="0,8,0,0">
                                    <StackPanel Margin="6">
                                        <Button Content="剖面定位源构件" Tag="LocateSourceElement" Height="30" Margin="0,0,0,6" Click="CommandButton_Click"/>
                                        <Button Content="查询关联剖面" Tag="FindRelatedSections" Height="30" Click="CommandButton_Click"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="转换与配置" Margin="0,8,0,0">
                                    <StackPanel Margin="6">
                                        <Button Content="楼层配置" Tag="FloorConfig" Height="30" Margin="0,0,0,6" Click="CommandButton_Click"/>
                                        <Button Content="图层映射" Tag="LayerMapping" Height="30" Margin="0,0,0,6" Click="CommandButton_Click"/>
                                        <Button Content="区域转换" Tag="ConvertRegion" Height="30" Margin="0,0,0,6" Click="CommandButton_Click"/>
                                        <Button Content="恢复转换" Tag="RevertConversion" Height="30" Click="CommandButton_Click"/>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="楼层配置">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#F4F7FB"
                            BorderBrush="#D7E0EC"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8"
                            Margin="0,0,0,8">
                        <DockPanel LastChildFill="True">
                            <Button Content="刷新楼层配置"
                                    Width="108"
                                    Height="28"
                                    DockPanel.Dock="Right"
                                    Click="RefreshFloorConfigButton_Click"/>
                            <TextBlock x:Name="FloorConfigBindingText"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>

                    <local:FloorConfigPanel Grid.Row="1" x:Name="FloorConfigPanelHost"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
