<Window x:Class="MetroToolKits.SectionGenerator.Plugin.UI.LayerMappingManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图层映射管理器" Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题说明 -->
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10">
            <Run Text="将左侧图层拖拽到右侧构件类型上建立映射关系，或右键选择映射类型。"/>
        </TextBlock>

        <!-- 主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：图层列表 -->
            <GroupBox Grid.Column="0" Header="图纸图层" Padding="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0" x:Name="SearchTextBox" 
                             TextChanged="SearchTextBox_TextChanged"
                             Margin="0,0,0,5" Padding="3"/>
                    <ListBox Grid.Row="1" x:Name="LayerListBox"
                             SelectionMode="Extended"
                             AllowDrop="True"
                             MouseDoubleClick="LayerListBox_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="14" Margin="0,0,5,0"
                                            Background="{Binding ColorBrush}"/>
                                    <TextBlock Text="{Binding LayerName}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>

            <!-- 中间：操作按钮 -->
            <StackPanel Grid.Column="1" Orientation="Vertical" 
                        VerticalAlignment="Center" Margin="10,0">
                <Button Content="→" Width="40" Height="30" Margin="0,5"
                        Click="MapButton_Click" ToolTip="建立映射"/>
                <Button Content="←" Width="40" Height="30" Margin="0,5"
                        Click="UnmapButton_Click" ToolTip="取消映射"/>
                <Button Content="⟳" Width="40" Height="30" Margin="0,5"
                        Click="RefreshButton_Click" ToolTip="刷新列表"/>
            </StackPanel>

            <!-- 右侧：构件类型列表 -->
            <GroupBox Grid.Column="2" Header="构件类型" Padding="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox Grid.Row="0" x:Name="TypeListBox"
                             AllowDrop="True"
                             Drop="TypeListBox_Drop"
                             DragOver="TypeListBox_DragOver">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="14" Margin="0,0,5,0"
                                            Background="{Binding ColorBrush}"/>
                                    <TextBlock Text="{Binding TypeName}"/>
                                    <TextBlock Text="{Binding ShortcutKey, StringFormat=' ({0})'}" 
                                               Foreground="Gray" Margin="5,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- 已建立映射列表 -->
                    <GroupBox Grid.Row="1" Header="已建立映射" Margin="0,10,0,0">
                        <ListBox x:Name="MappingListBox" MaxHeight="120">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding LayerName}"/>
                                        <Run Text=" → "/>
                                        <Run Text="{Binding TypeName}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </GroupBox>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="应用映射" Width="100" Height="30" Margin="5,0"
                    Click="ApplyButton_Click" IsDefault="True"/>
            <Button Content="取消" Width="80" Height="30" Margin="5,0"
                    Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
