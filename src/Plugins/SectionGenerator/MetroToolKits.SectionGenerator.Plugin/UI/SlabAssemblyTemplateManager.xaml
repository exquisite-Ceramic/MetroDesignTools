<Window x:Class="MetroToolKits.SectionGenerator.Plugin.UI.SlabAssemblyTemplateManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="楼板模板管理" Height="620" Width="920"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Column="0" Header="模板列表" Margin="0,0,8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ListBox x:Name="TemplateListBox"
                         SelectionChanged="TemplateListBox_SelectionChanged"
                         DisplayMemberPath="TemplateName"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="新增" Width="70" Margin="0,0,6,0" Click="AddTemplate_Click"/>
                    <Button Content="删除" Width="70" Click="RemoveTemplate_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <GroupBox Header="基本信息">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="模板名称:"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TemplateNameBox" Margin="0,2"/>
                    <Label Grid.Row="0" Grid.Column="2" Content="模板标识:" Margin="8,0,0,0"/>
                    <TextBox Grid.Row="0" Grid.Column="3" x:Name="TemplateIdBox" Margin="0,2"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="交接策略:"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="WallJunctionModeBox" Margin="0,2"/>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="核心板规则" Margin="0,8,0,0">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="名称:"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="CoreNameBox" Margin="0,2"/>
                    <Label Grid.Row="0" Grid.Column="2" Content="厚度 (mm):" Margin="8,0,0,0"/>
                    <TextBox Grid.Row="0" Grid.Column="3" x:Name="CoreThicknessBox" Margin="0,2"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="类别:"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="CoreCategoryBox" Margin="0,2"/>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="顶部附加层" Margin="0,8,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="TopLayerGrid" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="顺序" Binding="{Binding Order}" Width="60"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="厚度" Binding="{Binding Thickness}" Width="80"/>
                            <DataGridTextColumn Header="类别" Binding="{Binding MaterialOrCategory}" Width="140"/>
                            <DataGridCheckBoxColumn Header="可见" Binding="{Binding VisibleInSection}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="新增" Width="70" Margin="0,0,6,0" Click="AddTopLayer_Click"/>
                        <Button Content="删除" Width="70" Click="RemoveTopLayer_Click"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="3" Header="底部附加层" Margin="0,8,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="BottomLayerGrid" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="顺序" Binding="{Binding Order}" Width="60"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="厚度" Binding="{Binding Thickness}" Width="80"/>
                            <DataGridTextColumn Header="类别" Binding="{Binding MaterialOrCategory}" Width="140"/>
                            <DataGridCheckBoxColumn Header="可见" Binding="{Binding VisibleInSection}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="新增" Width="70" Margin="0,0,6,0" Click="AddBottomLayer_Click"/>
                        <Button Content="删除" Width="70" Click="RemoveBottomLayer_Click"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="保存" Width="90" Margin="0,0,6,0" Click="SaveButton_Click"/>
            <Button Content="取消" Width="90" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
