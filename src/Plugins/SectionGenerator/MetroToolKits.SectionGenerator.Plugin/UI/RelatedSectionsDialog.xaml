<Window x:Class="MetroToolKits.SectionGenerator.Plugin.UI.RelatedSectionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关联剖面" Height="360" Width="620"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="SummaryText" Grid.Row="0" Margin="0,0,0,8"/>

        <DataGrid Grid.Row="1" x:Name="ResultGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  MouseDoubleClick="ResultGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="剖面名称" Width="*" Binding="{Binding BlockName}"/>
                <DataGridTextColumn Header="关联楼层" Width="180" Binding="{Binding RelatedFloorsText}"/>
                <DataGridTextColumn Header="生成时间" Width="160" Binding="{Binding GeneratedAtText}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="定位选中剖面" Width="110" Height="30" Margin="5,0"
                    Click="LocateSelected_Click"/>
            <Button Content="关闭" Width="80" Height="30" Margin="5,0"
                    Click="Close_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
