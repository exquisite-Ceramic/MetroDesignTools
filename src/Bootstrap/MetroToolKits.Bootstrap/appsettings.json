{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "MetroToolKits.Bootstrap": "Information",
      "MetroToolKits.SectionGenerator.Core": "Warning",
      "MetroToolKits.SectionGenerator.Infrastructure": "Information",
      "MetroToolKits.SectionGenerator.CadAdapter": "Information"
    },
    "Outputs": {
      "File": {
        "Enabled": true,
        "Path": "logs/MetroToolKits.log",
        "UserLogPath": "logs/MetroToolKits_User.log",
        "MaxFileSizeMB": 10
      },
      "AcadCommandLine": {
        "Enabled": true,
        "MinLevel": "Warning"
      }
    }
  },
  "UserLogging": {
    "Verbosity": "Normal"
  },
  "DeveloperMode": false
}
